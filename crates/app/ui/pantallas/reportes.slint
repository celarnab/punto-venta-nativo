// Reportes del periodo: cifras, ventas por día/semana/mes y rankings. Las devoluciones restan.

import { Button, LineEdit, ComboBox, ScrollView } from "std-widgets.slint";
import { Api, ApartadoUi } from "../api.slint";
import { Tema, Panel, Titulo, Subtitulo, Nota } from "../comunes.slint";

component Cifra inherits Panel {
    in property <string> etiqueta;
    in property <string> valor;
    in property <string> detalle;
    in property <bool> grande;
    height: 86px;
    VerticalLayout {
        padding: 10px;
        spacing: 2px;
        Text { text: etiqueta; color: Tema.texto-2; font-size: 12px; }
        Text { text: valor; color: Tema.texto; font-size: grande ? 26px : 20px; font-weight: 700; }
        if detalle != "": Text { text: detalle; color: Tema.texto-3; font-size: 11px; overflow: elide; }
    }
}

component Barras inherits Panel {
    in property <ApartadoUi> apartado;
    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        Subtitulo { text: apartado.titulo; }
        if apartado.filas.length == 0: Nota { text: "Sin ventas en el periodo."; }
        for f in apartado.filas: HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Text { text: f.etiqueta; width: 34%; overflow: elide; color: Tema.texto-2; vertical-alignment: center; }
            Rectangle {
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, f.proporcion);
                    height: 12px;
                    background: Tema.acento;
                }
            }
            Text { text: f.valor; width: 95px; horizontal-alignment: right; vertical-alignment: center; color: Tema.texto; }
        }
    }
}

/// Una columna por periodo, con el monto al pasar el mouse.
component Columnas inherits Panel {
    in property <ApartadoUi> apartado;
    property <int> encima: -1;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            Subtitulo { text: apartado.titulo; }
            Text {
                text: encima >= 0 ? apartado.filas[encima].etiqueta + ": " + apartado.filas[encima].valor : "";
                horizontal-alignment: right;
                color: Tema.texto;
                font-weight: 700;
            }
        }
        Rectangle {
            height: 170px;
            HorizontalLayout {
                spacing: 2px;
                for f[i] in apartado.filas: Rectangle {
                    Rectangle {
                        y: parent.height * (1 - max(0, f.proporcion));
                        height: parent.height * max(0, f.proporcion);
                        width: min(parent.width, 22px);
                        background: encima == i ? #174a87 : Tema.acento;
                    }
                    TouchArea {
                        moved => { encima = i; }
                        pointer-event(e) => { if e.kind == PointerEventKind.cancel { encima = -1; } }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Tema.borde; }
        HorizontalLayout {
            Text { text: apartado.filas.length > 0 ? apartado.filas[0].etiqueta : ""; color: Tema.texto-3; font-size: 11px; }
            Text { text: apartado.filas.length > 0 ? apartado.filas[apartado.filas.length - 1].etiqueta : ""; color: Tema.texto-3; font-size: 11px; horizontal-alignment: right; }
        }
    }
}

export component Reportes inherits Rectangle {
    property <int> periodo: 0;
    property <int> cajero: 0;
    init => { cargar(); }
    function cargar() {
        Api.cargar-reporte(periodo, desde.text, hasta.text, cajero);
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Titulo { text: "Reportes"; vertical-alignment: center; }
            Nota { text: Api.reporte.periodo; vertical-alignment: center; }
            Rectangle { }
            Button { text: "Exportar a Excel"; clicked => { Api.exportar-reporte(); } }
        }
        HorizontalLayout {
            spacing: 6px;
            ComboBox {
                width: 160px;
                model: ["Hoy", "Ayer", "Esta semana", "Este mes", "Mes pasado", "Este año", "Otro periodo"];
                current-index <=> periodo;
                selected => { cargar(); }
            }
            desde := LineEdit { width: 110px; placeholder-text: "AAAA-MM-DD"; enabled: periodo == 6; accepted => { cargar(); } }
            Text { text: "al"; vertical-alignment: center; color: Tema.texto-2; }
            hasta := LineEdit { width: 110px; placeholder-text: "AAAA-MM-DD"; enabled: periodo == 6; accepted => { cargar(); } }
            if periodo == 6: Button { text: "Ver"; clicked => { cargar(); } }
            Rectangle { }
            ComboBox { width: 200px; model: Api.cajeros-filtro; current-index <=> cajero; selected => { cargar(); } }
        }
        ScrollView {
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Cifra {
                        etiqueta: "Total vendido";
                        valor: Api.reporte.total;
                        grande: true;
                        detalle: Api.reporte.devoluciones != "$0.00" ? Api.reporte.vendido + " en ventas − " + Api.reporte.devoluciones + " devuelto" : "";
                    }
                    Cifra { etiqueta: "Ventas"; valor: Api.reporte.ventas; }
                    Cifra { etiqueta: "Ticket promedio"; valor: Api.reporte.promedio; }
                    Cifra { etiqueta: "Utilidad"; valor: Api.reporte.utilidad; detalle: Api.reporte.margen; }
                }
                if Api.reporte.apartados.length > 0: Columnas { apartado: Api.reporte.apartados[0]; }
                GridLayout {
                    spacing: 10px;
                    Row {
                        if Api.reporte.apartados.length > 1: Barras { apartado: Api.reporte.apartados[1]; }
                        if Api.reporte.apartados.length > 2: Barras { apartado: Api.reporte.apartados[2]; }
                    }
                    Row {
                        if Api.reporte.apartados.length > 3: Barras { apartado: Api.reporte.apartados[3]; }
                        if Api.reporte.apartados.length > 4: Barras { apartado: Api.reporte.apartados[4]; }
                    }
                    Row {
                        if Api.reporte.apartados.length > 5: Barras { apartado: Api.reporte.apartados[5]; }
                        if Api.reporte.apartados.length > 6: Barras { apartado: Api.reporte.apartados[6]; }
                    }
                }
            }
        }
    }
}
