// Catálogo: buscar, dar de alta, editar, borrar, familias, existencias e importación de Excel.

import { Button, LineEdit, ListView, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Api, EditorProductoUi, LoteUi } from "../api.slint";
import { Tema, Panel, Titulo, Subtitulo, Nota, Campo, Dialogo, Insignia, Cabecera, Columna, Renglon, Celda, Palomita } from "../comunes.slint";

/// El color de cada estado de un lote.
component EstadoLote inherits Insignia {
    in property <string> clave;
    tinta: clave == "caducado" ? Tema.peligro : clave == "por_caducar" ? Tema.aviso : clave == "retirado" ? Tema.texto-2 : Tema.exito;
    fondo: clave == "caducado" ? Tema.peligro-suave : clave == "por_caducar" ? Tema.aviso-suave : clave == "retirado" ? Tema.panel-2 : Tema.exito-suave;
}

/// Farmacias: los lotes del producto abierto y el alta de uno nuevo. Un clic en un lote lo abre para editarlo,
/// contarlo o retirarlo.
component Lotes inherits VerticalLayout {
    in property <string> unidad;
    callback resultado(string);
    property <bool> agregando;
    property <bool> ya-estaba;
    property <string> referencia;
    spacing: 6px;
    Subtitulo { text: "Lotes"; }
    if Api.lotes.length == 0: Nota { text: "Sin lotes. Agrega uno cuando llegue mercancía, o asígnale lote a la que ya tienes."; wrap: word-wrap; }
    if Api.lotes.length > 0: Panel {
        height: min(Api.lotes.length, 4) * 28px + 2px;
        ListView {
            for l[i] in Api.lotes: Renglon {
                indice: i;
                height: 28px;
                clicked => { Api.lote-abierto = i; }
                Celda { text: l.numero; font-size: 12px; fuerte: true; }
                Celda { text: l.caducidad; font-size: 11px; width: 72px; tenue: true; }
                Celda { text: l.existencia; font-size: 12px; width: 60px; derecha: true; }
                HorizontalLayout {
                    width: 84px;
                    alignment: end;
                    if l.clave != "vigente": EstadoLote { text: l.estado; clave: l.clave; y: 5px; }
                }
            }
        }
    }
    if Api.lotes.length > 0 && Api.editor.sin-lote.to-float() > 0: Nota { text: "Sin lote: " + Api.editor.sin-lote + " " + unidad; }
    if Api.puede-inventario && !agregando: Button { text: "+ Agregar lote"; clicked => { agregando = true; ya-estaba = false; referencia = ""; } }
    if Api.puede-inventario && agregando: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            numero := Campo { etiqueta: "Lote"; placeholder: "A2304"; init => { self.enfocar(); } }
            caducidad := Campo { etiqueta: "Caducidad"; placeholder: "dd/mm/aaaa"; width: 130px; }
        }
        HorizontalLayout {
            spacing: 6px;
            fabricacion := Campo { etiqueta: "Fabricación"; placeholder: "dd/mm/aaaa (opcional)"; }
            cantidad := Campo { etiqueta: "Cantidad"; numero: true; width: 100px; }
        }
        if Api.editor.sin-lote.to-float() > 0: CheckBox {
            text: "Ya está en la existencia (" + Api.editor.sin-lote + " sin lote)";
            checked <=> ya-estaba;
        }
        if !ya-estaba: Campo { etiqueta: "Factura / proveedor"; text: referencia; edited(t) => { referencia = t; } }
        HorizontalLayout {
            spacing: 6px;
            Button { text: "Cancelar"; clicked => { agregando = false; } }
            Button {
                text: ya-estaba ? "Asignar lote" : "Registrar entrada";
                primary: true;
                enabled: numero.text != "" && caducidad.text != "" && cantidad.text != "";
                clicked => {
                    let error = Api.agregar-lote({
                        producto: Api.editor.id,
                        numero: numero.text,
                        fabricacion: fabricacion.text,
                        caducidad: caducidad.text,
                        cantidad: cantidad.text,
                        ya-estaba: ya-estaba,
                        referencia: ya-estaba ? "" : referencia,
                    });
                    if error == "" { agregando = false; }
                    root.resultado(error);
                }
            }
        }
    }
}

/// Editar, contar o retirar el lote `Api.lotes[Api.lote-abierto]`.
component EditarLote inherits Dialogo {
    property <LoteUi> lote: Api.lotes[Api.lote-abierto];
    property <string> error;
    property <bool> confirmando;
    titulo: "Lote " + lote.numero + " — " + Api.editor.nombre;
    ancho: 440px;
    HorizontalLayout {
        spacing: 8px;
        EstadoLote { text: lote.estado; clave: lote.clave; }
        Nota { text: "Quedan " + lote.existencia; vertical-alignment: center; }
        Rectangle { }
    }
    HorizontalLayout {
        spacing: 8px;
        numero := Campo { etiqueta: "Lote"; text: lote.numero; }
        caducidad := Campo { etiqueta: "Caducidad"; text: lote.caducidad; placeholder: "dd/mm/aaaa"; width: 130px; }
        fabricacion := Campo { etiqueta: "Fabricación"; text: lote.fabricacion; placeholder: "Opcional"; width: 130px; }
    }
    if Api.puede-inventario: HorizontalLayout {
        alignment: end;
        Button {
            text: "Guardar cambios";
            clicked => {
                error = Api.editar-lote(lote.id, numero.text, fabricacion.text, caducidad.text);
                if error == "" { root.cerrar(); }
            }
        }
    }
    if Api.puede-inventario: HorizontalLayout {
        spacing: 8px;
        contada := Campo { etiqueta: "Conteo físico: hay realmente"; numero: true; }
        VerticalLayout {
            alignment: end;
            Button {
                text: "Ajustar";
                enabled: contada.text != "";
                clicked => {
                    error = Api.contar-lote(lote.id, contada.text);
                    if error == "" { root.cerrar(); }
                }
            }
        }
    }
    if Api.puede-inventario && !confirmando: HorizontalLayout {
        Button { text: "Retirar del inventario…"; clicked => { confirmando = true; } }
        Rectangle { }
    }
    if confirmando: Rectangle {
        background: Tema.peligro-suave;
        height: aviso.preferred-height + 16px;
        aviso := VerticalLayout {
            padding: 8px;
            spacing: 6px;
            Text {
                text: "Se sacan " + lote.existencia + " del inventario y cuentan como pérdida por caducidad" + (Api.puede-productos ? " (" + lote.perdida + ")." : ".");
                color: Tema.peligro;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                Button { text: "No"; clicked => { confirmando = false; } }
                Button {
                    text: "Sí, retirar";
                    primary: true;
                    clicked => {
                        error = Api.retirar-lote(lote.id);
                        if error == "" { root.cerrar(); }
                    }
                }
            }
        }
    }
    if error != "": Text { text: error; color: Tema.peligro; wrap: word-wrap; }
}

/// Existencia, entradas, conteos y últimos movimientos del producto abierto. Las entradas y los conteos solo
/// aparecen para quien maneja el inventario. En una farmacia, primero los lotes; lo de sin lote queda a un clic.
component Existencias inherits VerticalLayout {
    in property <bool> granel;
    callback resultado(string); // vacío si salió bien; si no, el error
    property <bool> sin-lote-abierto;
    spacing: 8px;
    Subtitulo { text: "Existencia: " + Api.editor.existencia + " " + (granel ? "kg" : Api.editor.unidad); }
    if Api.es-farmacia: Lotes {
        unidad: granel ? "kg" : Api.editor.unidad;
        resultado(mensaje) => { root.resultado(mensaje); }
    }
    if Api.es-farmacia && Api.puede-inventario: HorizontalLayout {
        Button {
            text: sin-lote-abierto ? "Ocultar entrada y conteo sin lote" : "Entrada o conteo sin lote…";
            clicked => { sin-lote-abierto = !sin-lote-abierto; }
        }
        Rectangle { }
    }
    if Api.puede-inventario && (!Api.es-farmacia || sin-lote-abierto): VerticalLayout {
        spacing: 8px;
        entrada := Campo { etiqueta: "Llegó mercancía (cantidad)"; numero: true; }
        referencia := Campo { etiqueta: "Factura / proveedor"; }
        Button {
            text: "Registrar entrada";
            enabled: entrada.text != "";
            clicked => {
                let error = Api.registrar-entrada(Api.editor.id, entrada.text, referencia.text);
                if error == "" { entrada.text = ""; referencia.text = ""; }
                root.resultado(error);
            }
        }
        contada := Campo { etiqueta: "Conteo físico: hay realmente"; numero: true; }
        Button {
            text: "Ajustar existencia";
            enabled: contada.text != "";
            clicked => {
                let error = Api.ajustar-existencia(Api.editor.id, contada.text, "Conteo físico");
                if error == "" { contada.text = ""; }
                root.resultado(error);
            }
        }
    }
    Text { text: "Últimos movimientos"; font-size: 12px; color: Tema.texto-2; font-weight: 700; }
    Panel {
        min-height: Api.es-farmacia ? 100px : 160px;
        ListView {
            for m[i] in Api.movimientos: Renglon {
                indice: i;
                height: 24px;
                Celda { text: m.fecha; font-size: 11px; width: 70px; }
                Celda { text: m.tipo; font-size: 11px; }
                Celda { text: m.cantidad; font-size: 11px; derecha: true; width: 50px; }
            }
        }
    }
}

/// Para quien maneja el inventario pero no los productos: ve el producto y mueve su existencia, sin editarlo.
component VerExistencias inherits Dialogo {
    titulo: Api.editor.nombre;
    ancho: Api.es-farmacia ? 460px : 420px;
    property <string> error;
    Nota { text: Api.editor.codigo + " · " + Api.pesos(Api.editor.precio.to-float()) + (Api.editor.granel ? " por kg" : " por " + Api.editor.unidad); }
    Existencias {
        granel: Api.editor.granel;
        resultado(mensaje) => { error = mensaje; }
    }
    if error != "": Text { text: error; color: Tema.peligro; wrap: word-wrap; }
    HorizontalLayout {
        alignment: end;
        Button { text: "Cerrar"; clicked => { root.cerrar(); } }
    }
}

component EditorProducto inherits Dialogo {
    titulo: Api.editor.id == 0 ? "Nuevo producto" : Api.editor.nombre;
    ancho: Api.es-farmacia ? 980px : 900px;
    property <int> familia: Api.editor.familia-indice;
    property <bool> granel: Api.editor.granel;
    property <bool> activo: Api.editor.activo;
    property <bool> nueva-familia;
    property <string> error;
    property <bool> confirmando-borrado;

    HorizontalLayout {
        spacing: 16px;
        // Columna izquierda: datos del producto.
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 10px;
                codigo := Campo { etiqueta: "Código"; text: Api.editor.codigo; width: 130px; init => { if Api.editor.id == 0 { self.enfocar(); } } }
                codigo-barras := Campo { etiqueta: "Código de barras"; text: Api.editor.codigo-barras; width: 160px; placeholder: "Opcional"; }
                nombre := Campo { etiqueta: "Nombre"; text: Api.editor.nombre; }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Familia"; font-size: 12px; color: Tema.texto-2; }
                    HorizontalLayout {
                        spacing: 4px;
                        ComboBox { model: Api.familias-nombres; current-index <=> familia; }
                        Button { text: "+ Nueva"; clicked => { nueva-familia = !nueva-familia; } }
                    }
                    if nueva-familia: HorizontalLayout {
                        spacing: 4px;
                        nombre-familia := LineEdit { placeholder-text: "Nombre de la familia"; }
                        Button {
                            text: "Crear";
                            enabled: nombre-familia.text != "";
                            clicked => {
                                let indice = Api.crear-familia(nombre-familia.text, "");
                                if indice >= 0 {
                                    familia = indice;
                                    nueva-familia = false;
                                }
                            }
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    Text { text: "Se vende"; font-size: 12px; color: Tema.texto-2; }
                    CheckBox { text: "A granel, por kilo"; checked <=> granel; }
                    CheckBox { text: "Activo (se puede vender)"; checked <=> activo; }
                }
                unidad := Campo {
                    etiqueta: "Unidad";
                    width: 90px;
                    text: granel ? "kg" : Api.editor.unidad;
                    habilitado: !granel;
                    ayuda: granel ? "" : "pza, m, caja…";
                }
            }
            HorizontalLayout {
                spacing: 10px;
                precio := Campo { etiqueta: granel ? "Precio por kg (IVA incluido)" : "Precio (IVA incluido)"; numero: true; text: Api.editor.precio; }
                costo := Campo { etiqueta: granel ? "Costo por kg" : "Costo"; numero: true; text: Api.editor.costo; ayuda: "No se vende por debajo sin autorización."; }
                VerticalLayout {
                    spacing: 3px;
                    Text { text: "Margen"; font-size: 12px; color: Tema.texto-2; }
                    Text {
                        text: precio.text.to-float() > 0 ? round((precio.text.to-float() - costo.text.to-float()) / precio.text.to-float() * 1000) / 10 + " %" : "—";
                        font-size: 16px;
                        font-weight: 700;
                        color: precio.text.to-float() >= costo.text.to-float() ? Tema.exito : Tema.peligro;
                    }
                }
            }
            Subtitulo { text: "Otros precios"; }
            Nota { text: "Al vender un producto con varios precios se pregunta cuál. Con «desde», ese precio se sugiere al llevar esa cantidad (mayoreo), pero el cajero decide."; }
            for pr[i] in Api.editor.precios: HorizontalLayout {
                spacing: 6px;
                LineEdit { text: pr.nombre; placeholder-text: "Mayoreo, Contratista…"; edited(t) => { Api.editar-otro-precio(i, 0, t); } }
                LineEdit { text: pr.precio; width: 100px; placeholder-text: "Precio"; horizontal-alignment: right; edited(t) => { Api.editar-otro-precio(i, 1, t); } }
                LineEdit { text: pr.desde; width: 110px; placeholder-text: "Desde (opcional)"; horizontal-alignment: right; edited(t) => { Api.editar-otro-precio(i, 2, t); } }
                Button { text: "✕"; width: 32px; clicked => { Api.quitar-otro-precio(i); } }
            }
            HorizontalLayout {
                Button { text: "+ Agregar precio"; clicked => { Api.agregar-otro-precio(); } }
                Rectangle { }
            }
            HorizontalLayout {
                spacing: 10px;
                minimo := Campo { etiqueta: "Stock mínimo"; numero: true; text: Api.editor.stock-minimo; }
                maximo := Campo { etiqueta: "Stock máximo"; numero: true; text: Api.editor.stock-maximo; }
                alerta := Campo { etiqueta: "Avisar con existencia de"; numero: true; text: Api.editor.alerta; placeholder: "El de la familia"; }
            }
        }
        // Columna derecha: existencias (solo productos ya guardados).
        if Api.editor.id != 0: Existencias {
            width: Api.es-farmacia ? 330px : 250px;
            granel: granel;
            resultado(mensaje) => { error = mensaje; }
        }
    }
    if error != "": Text { text: error; color: Tema.peligro; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        if Api.editor.id != 0 && !confirmando-borrado: Button { text: "Borrar producto"; clicked => { confirmando-borrado = true; } }
        if confirmando-borrado: Text { text: "¿Seguro? Se conserva en el historial."; color: Tema.peligro; vertical-alignment: center; }
        if confirmando-borrado: Button {
            text: "Sí, borrar";
            clicked => {
                error = Api.borrar-producto(Api.editor.id);
                if error == "" { root.cerrar(); }
            }
        }
        if confirmando-borrado: Button { text: "No"; clicked => { confirmando-borrado = false; } }
        Rectangle { }
        Button { text: "Cancelar"; clicked => { root.cerrar(); } }
        Button {
            text: "Guardar";
            primary: true;
            clicked => {
                error = Api.guardar-producto({
                    id: Api.editor.id,
                    codigo: codigo.text,
                    codigo-barras: codigo-barras.text,
                    nombre: nombre.text,
                    familia-indice: familia,
                    granel: granel,
                    unidad: unidad.text,
                    precio: precio.text,
                    costo: costo.text,
                    stock-minimo: minimo.text,
                    stock-maximo: maximo.text,
                    alerta: alerta.text,
                    activo: activo,
                });
                if error == "" { root.cerrar(); }
            }
        }
    }
}

component Familias inherits Dialogo {
    titulo: "Familias de productos";
    ancho: 520px;
    property <string> error;
    Nota { text: "Agrupan productos para los reportes. El aviso de existencia aplica a los productos que no tengan el suyo."; }
    Panel {
        height: 280px;
        VerticalLayout {
            Cabecera {
                Columna { text: "Nombre"; }
                Columna { text: "Avisar con"; width: 90px; }
                Rectangle { width: 150px; }
            }
            ListView {
                for f[i] in Api.familias: Renglon {
                    indice: i;
                    height: 34px;
                    nombre := LineEdit { text: f.nombre; }
                    alerta := LineEdit { text: f.alerta; width: 90px; placeholder-text: "Sin aviso"; horizontal-alignment: right; }
                    HorizontalLayout {
                        width: 150px;
                        spacing: 4px;
                        Button { text: "Guardar"; clicked => { error = Api.renombrar-familia(f.id, nombre.text, alerta.text); } }
                        Button { text: "Borrar"; clicked => { Api.borrar-familia(f.id); } }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 6px;
        nueva := LineEdit { placeholder-text: "Nueva familia"; }
        nueva-alerta := LineEdit { placeholder-text: "Avisar con"; width: 90px; horizontal-alignment: right; }
        Button {
            text: "Agregar";
            enabled: nueva.text != "";
            clicked => {
                if Api.crear-familia(nueva.text, nueva-alerta.text) >= 0 {
                    nueva.text = "";
                    nueva-alerta.text = "";
                }
            }
        }
    }
    if error != "": Text { text: error; color: Tema.peligro; }
}

/// Farmacias: los lotes caducados y los que caducan pronto, de todo el catálogo, para retirarlos.
component Caducidades inherits Panel {
    callback retirar(int); // índice en `Api.avisos-caducidad`
    VerticalLayout {
        Cabecera {
            Columna { text: "Caducidad"; width: 90px; }
            Columna { text: "Producto"; }
            Columna { text: "Lote"; width: 120px; }
            Columna { text: "Existencia"; width: 90px; derecha: true; }
            if Api.puede-productos: Columna { text: "Pérdida"; width: 90px; derecha: true; }
            Columna { text: "Estado"; width: 100px; }
            if Api.puede-inventario: Rectangle { width: 90px; }
        }
        if Api.avisos-caducidad.length == 0: Rectangle {
            Nota { text: "Ningún lote caducado ni por caducar en los próximos 60 días."; horizontal-alignment: center; vertical-alignment: center; }
        }
        ListView {
            for l[i] in Api.avisos-caducidad: Renglon {
                indice: i;
                Celda { text: l.caducidad; width: 90px; fuerte: l.clave == "caducado"; }
                HorizontalLayout {
                    spacing: 6px;
                    Celda { text: l.producto; }
                    Celda { text: l.codigo; tenue: true; width: 90px; }
                }
                Celda { text: l.numero; width: 120px; }
                Celda { text: l.existencia; width: 90px; derecha: true; }
                if Api.puede-productos: Celda { text: l.perdida; width: 90px; derecha: true; tenue: true; }
                HorizontalLayout {
                    width: 100px;
                    alignment: start;
                    EstadoLote { text: l.estado; clave: l.clave; y: 6px; }
                }
                if Api.puede-inventario: HorizontalLayout {
                    width: 90px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Button { text: "Retirar"; clicked => { root.retirar(i); } }
                }
            }
        }
    }
}

export component Productos inherits Rectangle {
    property <bool> inactivos;
    property <bool> por-surtir;
    property <bool> viendo-familias;
    property <bool> caducidades: Api.es-farmacia && Api.viendo-caducidades;
    property <int> retirando: -1;
    property <string> error-retiro;
    property <bool> borrando-marcados;
    property <string> error-borrado;
    property <bool> todos-marcados: Api.productos.length > 0 && Api.marcados == Api.productos.length;
    init => {
        Api.buscar-productos("", false, false);
        if caducidades { Api.cargar-caducidades(); }
    }

    property <string> texto;
    function buscar() {
        Api.buscar-productos(texto, inactivos, por-surtir);
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Titulo { text: caducidades ? "Caducidades" : "Productos"; vertical-alignment: center; }
            if Api.es-farmacia: Button {
                text: caducidades ? "← Volver a productos" : Api.caducados == 1 ? "Caducidades (1 caducado)" : Api.caducados > 1 ? "Caducidades (" + Api.caducados + " caducados)" : "Caducidades";
                clicked => {
                    Api.viendo-caducidades = !caducidades;
                    if Api.viendo-caducidades { Api.cargar-caducidades(); } else { buscar(); }
                }
            }
            Rectangle { }
            if Api.puede-productos: Button { text: "Familias"; clicked => { viendo-familias = true; } }
            if Api.puede-productos: Button { text: "Importar Excel"; clicked => { Api.elegir-importacion(); } }
            if Api.puede-productos: Button { text: "Exportar Excel"; clicked => { Api.exportar-productos(); } }
            if Api.puede-productos: Button { text: "Nuevo producto"; primary: true; clicked => { Api.editar-producto(0); } }
        }
        if caducidades: Nota { text: "Lo caducado ya no se puede vender. Al sacarlo del anaquel, «Retirar» lo quita del inventario y su costo cuenta como pérdida en los reportes."; wrap: word-wrap; }
        if caducidades: Caducidades {
            retirar(i) => { error-retiro = ""; retirando = i; }
        }
        if !caducidades: HorizontalLayout {
            spacing: 14px;
            LineEdit {
                width: 380px;
                text: texto;
                placeholder-text: "Buscar por código, código de barras, nombre o familia";
                edited(t) => { texto = t; buscar(); }
            }
            CheckBox { text: "Solo por surtir"; checked <=> por-surtir; toggled => { buscar(); } }
            CheckBox { text: "Incluir desactivados"; checked <=> inactivos; toggled => { buscar(); } }
            Rectangle { }
            if Api.puede-productos && Api.marcados > 0: Text {
                text: Api.marcados == 1 ? "1 seleccionado" : Api.marcados + " seleccionados";
                color: Tema.texto-2;
                vertical-alignment: center;
            }
            if Api.puede-productos && Api.marcados > 0: Button { text: "Quitar selección"; clicked => { Api.marcar-todos(false); } }
            if Api.puede-productos && Api.marcados > 0: Button {
                text: "Borrar seleccionados";
                clicked => { error-borrado = ""; borrando-marcados = true; }
            }
        }
        if !caducidades: Panel {
            VerticalLayout {
                Cabecera {
                    if Api.puede-productos: Palomita {
                        marcado: todos-marcados;
                        clic => { Api.marcar-todos(!todos-marcados); }
                    }
                    Columna { text: "Código"; width: 130px; }
                    Columna { text: "Nombre"; }
                    Columna { text: "Familia"; width: 130px; }
                    Columna { text: "Se vende"; width: 90px; }
                    Columna { text: "Precio"; width: 95px; derecha: true; }
                    if Api.puede-productos: Columna { text: "Costo"; width: 90px; derecha: true; }
                    Columna { text: "Existencia"; width: 110px; derecha: true; }
                }
                if Api.productos.length == 0: Rectangle {
                    Nota { text: por-surtir ? "Nada por surtir." : "No hay productos que coincidan."; horizontal-alignment: center; vertical-alignment: center; }
                }
                ListView {
                    for p[i] in Api.productos: Renglon {
                        indice: i;
                        seleccionado: p.marcado;
                        clicked => { if Api.puede-productos || Api.puede-inventario { Api.editar-producto(p.id); } }
                        if Api.puede-productos: Palomita {
                            marcado: p.marcado;
                            clic => { Api.marcar-producto(p.id, !p.marcado); }
                        }
                        Celda { text: p.codigo; width: 130px; tenue: true; }
                        HorizontalLayout {
                            spacing: 6px;
                            Celda { text: p.nombre; tenue: !p.activo; }
                            if p.otros-precios > 0: Insignia { text: (p.otros-precios + 1) + " precios"; y: 6px; }
                            if !p.activo: Insignia { text: "desactivado"; y: 6px; }
                        }
                        Celda { text: p.familia; width: 130px; }
                        Celda { text: p.granel ? "a granel (kg)" : "por " + p.unidad; width: 90px; tenue: true; }
                        Celda { text: p.precio + (p.granel ? "/kg" : ""); width: 95px; derecha: true; }
                        if Api.puede-productos: Celda { text: p.costo; width: 90px; derecha: true; tenue: true; }
                        HorizontalLayout {
                            width: 110px;
                            alignment: end;
                            spacing: 4px;
                            if p.alerta: Insignia { text: "surtir"; tinta: Tema.aviso; fondo: Tema.aviso-suave; y: 6px; }
                            Celda { text: p.existencia + " " + p.unidad; derecha: true; }
                        }
                    }
                }
            }
        }
    }

    if Api.editando && Api.puede-productos: EditorProducto {
        cerrar => { Api.cerrar-editor(); buscar(); }
    }

    if Api.editando && !Api.puede-productos: VerExistencias {
        cerrar => { Api.cerrar-editor(); buscar(); }
    }

    if Api.editando && Api.lote-abierto >= 0 && Api.lote-abierto < Api.lotes.length: EditarLote {
        cerrar => { Api.lote-abierto = -1; }
    }

    if borrando-marcados && Api.marcados > 0: Dialogo {
        titulo: Api.marcados == 1 ? "Borrar 1 producto" : "Borrar " + Api.marcados + " productos";
        ancho: 460px;
        cerrar => { borrando-marcados = false; }
        Text {
            text: "Se quitan del catálogo y de las ventas en pausa. Las ventas que ya se cobraron y los reportes los conservan.";
            color: Tema.texto-2;
            wrap: word-wrap;
        }
        Panel {
            height: Math.min(Api.marcados, 8) * 24px + 12px;
            ScrollView {
                VerticalLayout {
                    padding: 6px;
                    // Los que no están palomeados quedan vacíos, sin alto.
                    for p in Api.productos: VerticalLayout {
                        if p.marcado: HorizontalLayout {
                            height: 24px;
                            padding-left: 4px;
                            padding-right: 4px;
                            spacing: 8px;
                            Celda { text: p.codigo; width: 110px; tenue: true; }
                            Celda { text: p.nombre; }
                        }
                    }
                }
            }
        }
        if error-borrado != "": Text { text: error-borrado; color: Tema.peligro; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button { text: "Cancelar"; clicked => { borrando-marcados = false; } }
            Button {
                text: Api.marcados == 1 ? "Sí, borrar 1 producto" : "Sí, borrar " + Api.marcados + " productos";
                primary: true;
                clicked => {
                    error-borrado = Api.borrar-marcados();
                    if error-borrado == "" { borrando-marcados = false; }
                }
            }
        }
    }

    if retirando >= 0 && retirando < Api.avisos-caducidad.length: Dialogo {
        property <LoteUi> lote: Api.avisos-caducidad[retirando];
        titulo: "Retirar el lote " + lote.numero;
        ancho: 420px;
        cerrar => { retirando = -1; }
        Text { text: lote.producto + " · " + lote.estado.to-lowercase() + " (" + lote.caducidad + ")"; color: Tema.texto; font-weight: 700; wrap: word-wrap; }
        Text {
            text: "Se sacan " + lote.existencia + " del inventario y cuentan como pérdida por caducidad" + (Api.puede-productos ? " (" + lote.perdida + ")." : ".");
            color: Tema.texto-2;
            wrap: word-wrap;
        }
        if error-retiro != "": Text { text: error-retiro; color: Tema.peligro; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button { text: "Cancelar"; clicked => { retirando = -1; } }
            Button {
                text: "Retirar";
                primary: true;
                clicked => {
                    error-retiro = Api.retirar-lote(lote.id);
                    if error-retiro == "" { retirando = -1; }
                }
            }
        }
    }

    if Api.importando: Dialogo {
        titulo: "Importar productos desde Excel";
        ancho: 820px;
        cerrar => { Api.cerrar-importacion(); }
        Nota { text: Api.importacion-resumen; }
        Panel {
            height: 340px;
            VerticalLayout {
                Cabecera {
                    Columna { text: "Fila"; width: 40px; derecha: true; }
                    Columna { text: "Código"; width: 120px; }
                    Columna { text: "Nombre"; width: 220px; }
                    Columna { text: "Qué pasará"; }
                }
                ListView {
                    for f[i] in Api.importacion: Renglon {
                        indice: i;
                        Celda { text: f.numero; width: 40px; derecha: true; tenue: true; }
                        Celda { text: f.codigo; width: 120px; }
                        Celda { text: f.nombre; width: 220px; }
                        HorizontalLayout {
                            spacing: 6px;
                            Insignia {
                                y: 6px;
                                text: f.accion;
                                tinta: f.accion == "Error" ? Tema.peligro : f.accion == "Nuevo" ? Tema.exito : f.accion == "Cambia" ? Tema.acento : Tema.texto-2;
                                fondo: f.accion == "Error" ? Tema.peligro-suave : f.accion == "Nuevo" ? Tema.exito-suave : f.accion == "Cambia" ? Tema.acento-suave : Tema.panel-2;
                            }
                            Celda { text: f.detalle; tenue: f.accion != "Error"; color: f.accion == "Error" ? Tema.peligro : Tema.texto-2; }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Button { text: "Elegir otro archivo"; clicked => { Api.elegir-importacion(); } }
            Rectangle { }
            Button { text: "Cancelar"; clicked => { Api.cerrar-importacion(); } }
            Button { text: "Importar"; primary: true; clicked => { Api.confirmar-importacion(); buscar(); } }
        }
    }

    if viendo-familias: Familias {
        cerrar => { viendo-familias = false; buscar(); }
    }
}
